{
  "expo": {
    "name": "PlaySplit",
    "slug": "player-draws",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#00897B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kalai.k.t.playsplit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/logo.png",
        "backgroundColor": "#00897B"
      },
      "package": "com.kalai.k.t.playsplit",
      "proguardRules": "./proguard-rules.pro"
    },
    "web": {
      "favicon": "assets/logo.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3699502919919350~7129784316",
          "iosAppId": "ca-app-pub-3699502919919350~8961740739"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "52507606-913c-4b44-9cb5-9d75edcf65b4"
      },
      "adUnitId": "ca-app-pub-3699502919919350/6457673389",
      "adUnitIdAndroid": "ca-app-pub-3699502919919350/5635546306"
    }
  }
}
